# PORT: Express server port. In AI Studio cloud preview, port 3000 is used by default.
PORT=3000

# NODE_ENV: Application environment (development | production)
NODE_ENV=development

# MONGODB_URI: Local MongoDB Community Server or MongoDB Atlas connection string.
# On Windows laptop local setup with MongoDB installed: mongodb://127.0.0.1:27017/freelance_hub
MONGODB_URI=mongodb://127.0.0.1:27017/freelance_hub

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET=freelance_hub_super_secret_jwt_key_development_2026

# COOKIE_SECRET: Secret key for signing cookies
COOKIE_SECRET=freelance_hub_cookie_signing_secret_key_2026

# CLIENT_URL: URL of the frontend application for CORS allowed origins
CLIENT_URL=http://localhost:3000

# GEMINI_API_KEY: Optional AI Studio integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Current application URL
APP_URL="MY_APP_URL"

